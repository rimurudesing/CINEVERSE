{
  "name": "cineverse",
  "version": "1.0.0",
  "description": "",
  "main": "desktop/main.cjs",
  "scripts": {
    "sync": "node build.js",
    "cap-sync": "npm run sync && npx cap sync android",
    "build:apk": "npm run cap-sync && cd android && JAVA_HOME=/opt/android-studio/jbr ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../Cineverse.apk",
    "build": "node build.js",
    "build:desktop": "node build.js && electron-builder --win",
    "build:linux": "node build.js && electron-builder --linux",
    "desktop": "electron desktop/main.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rimurudesing/CINEVERSE.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/rimurudesing/CINEVERSE/issues"
  },
  "homepage": "https://github.com/rimurudesing/CINEVERSE#readme",
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@supabase/supabase-js": "^2.110.6",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}